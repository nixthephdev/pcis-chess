        { "goal": "stars", "board": { "3": "*...*...", "1": "..B....." }, "tip": "Two stars. Zig and zag!" },
        { "goal": "stars", "board": { "8": "...*....", "6": ".*.....*", "3": "*.......", "1": "..B....." }, "tip": "Secret: a bishop stays on the SAME colour square forever!" },
        { "goal": "stars", "board": { "8": "..*.*...", "6": "*.......", "3": "......n*", "1": ".....B.." }, "tip": "Knights jump in an L shape. Stay away from the squares it guards!" }
