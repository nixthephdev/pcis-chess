        { "goal": "capture", "board": { "6": "n....b..", "1": "R......." }, "tip": "Capture ALL the black pieces. Land on a piece to take it!" },
        { "goal": "capture", "board": { "7": ".p....n.", "4": "...b....", "1": "...Q...." }, "tip": "Some pieces protect each other. Take the one nobody protects first!" },
        { "goal": "capture", "board": { "7": "..p.....", "6": "...p....", "5": ".....p..", "4": "....N..." }, "tip": "Pawns protect the pawn diagonally in front of them. Be careful, knight!" },
        { "goal": "capture", "board": { "8": "r.......", "6": "....n...", "3": "..p.....", "1": "R.B....." }, "tip": "Two heroes! Team up the rook and the bishop." }
