        { "goal": "stars", "board": { "7": ".*...p..", "4": "...*....", "1": "R......*" }, "tip": "Black pieces guard squares. Never land where the pawn can capture you! Pawns capture one step diagonally." },
        { "goal": "stars", "board": { "8": "..*..n..", "5": "*..R...*", "2": "..b....." }, "tip": "A knight AND a bishop are on guard. Tap Hint to see the danger squares." }
