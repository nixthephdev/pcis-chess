      "levels": [
        { "goal": "stars", "board": { "4": "....*...", "2": "....P..." }, "tip": "Pawns only move forward. On their very first move they may take 2 steps!" },
        { "goal": "stars", "board": { "7": ".....*..", "6": ".....*..", "5": ".....r..", "4": "....*...", "3": "....n...", "2": "...P...." }, "tip": "Pawns move straight but capture diagonally, one step forward." },
        { "goal": "stars", "board": { "8": ".*.....*", "6": ".P......" }, "tip": "Reach the last row and your pawn becomes a QUEEN! That is called promotion." }
      ]
