    {
      "id": "queen", "section": 0, "name": "The Queen", "piece": "q", "blurb": "Rook + bishop together",
      "levels": [
        { "goal": "stars", "board": { "8": "...*....", "5": ".......*", "4": "*.......", "1": "...Q...." }, "tip": "The queen is the strongest piece. She moves like a rook AND a bishop!" },
        { "goal": "stars", "board": { "8": "*......*", "6": "..b.....", "5": "....*...", "1": "Q......*" }, "tip": "A star is guarded? Capture the guard first!" }
      ]
    },
    {
      "id": "king", "section": 0, "name": "The King", "piece": "k", "blurb": "The most important piece",
      "levels": [
        { "goal": "stars", "board": { "4": ".....*..", "3": "....*...", "1": "....K..." }, "tip": "The king moves just ONE step, in any direction." },
        { "goal": "stars", "board": { "5": "..*...*.", "3": "....*...", "1": "....K..." }, "tip": "Step by step. Which star should the king visit first?" },
        { "goal": "stars", "board": { "7": "....*...", "6": ".......r", "5": ".*...*..", "4": "...K....", "2": "..*....." }, "tip": "CHALLENGE! The rook guards its whole row and column. Kings can capture too, if the square is safe!" }
      ]
    },
    {
      "id": "knight", "section": 0, "name": "The Knight", "piece": "n", "blurb": "Jumps in an L shape",
      "levels": [
        { "goal": "stars", "board": { "5": "...*....", "3": "..*.....", "1": ".N......" }, "tip": "Knights jump in an L: two squares one way, then one to the side. They can jump over pieces!" },
        { "goal": "stars", "board": { "7": "..*.....", "6": "....*...", "5": "......*.", "3": ".......*", "1": "......N." }, "tip": "Hop, hop, hop! Follow the stars." },
        { "goal": "stars", "board": { "6": "..p.....", "5": "...*....", "4": "...N*..." }, "tip": "Stars right next to a knight are the trickiest to reach. Think in L shapes!" }
