    },
    {
      "id": "check", "section": 2, "name": "Check in one", "piece": "n", "blurb": "Attack the king",
      "levels": [
        { "goal": "check", "board": { "8": "....k...", "1": "R...K..." }, "tip": "CHECK means you attack the enemy king. Make one move that attacks the black king!" },
        { "goal": "check", "board": { "8": "......k.", "7": "......pp", "1": ".....BK." }, "tip": "Find a diagonal that points at the king." },
        { "goal": "check", "board": { "8": "....k...", "4": "....N...", "1": "....K..." }, "tip": "Knights give sneaky checks. Nothing can block them!" },
        { "goal": "check", "board": { "8": ".......k", "7": "......pp", "1": "...Q..K." }, "tip": "The queen can check from far away." }
      ]
    },
    {
      "id": "mate", "section": 2, "name": "Mate in one", "piece": "k", "blurb": "Win the game!",
      "levels": [
        { "goal": "mate", "board": { "8": "......k.", "7": ".....ppp", "1": "R.....K." }, "tip": "CHECKMATE means the king is in check and cannot escape. That wins the game! Look at the back row." },
        { "goal": "mate", "board": { "8": "k.......", "7": ".......Q", "6": ".K......" }, "tip": "Your king can help the queen. Find the mate!" },
        { "goal": "mate", "board": { "8": ".......k", "7": "R.......", "1": ".R....K." }, "tip": "Two rooks make a ladder. One guards a row, the other gives check." },
        { "goal": "mate", "board": { "8": ".......k", "7": "......pp", "4": "......Q.", "2": ".B......", "1": "......K." }, "tip": "The bishop is aiming at a square next to the king. Use it!" }
